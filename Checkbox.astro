---
import Icon from "../ui/Icon.astro";

interface Props {
  name: string;
  label: string;
  required?: boolean;
  checked?: boolean;
  error?: string;
  id?: string;
}

const { name, label, required = false, checked = false, error, id } = Astro.props;
const inputId = id ?? `checkbox-${Math.random().toString(36).slice(2, 11)}`;
const errorId = error ? `${inputId}-error` : undefined;
---

<div class="flex flex-col gap-1">
  <label class="flex items-start gap-2.5 cursor-pointer" for={inputId}>
    <span class="cb-wrap">
      <input
        type="checkbox"
        id={inputId}
        name={name}
        checked={checked}
        required={required}
        class="cb-input"
        aria-describedby={errorId}
      />
      <span class="cb-box" aria-hidden="true">
        <span class="cb-icon"><Icon name="material-symbols:check" class="size-4" /></span>
      </span>
    </span>
    <span class="text-sm cursor-pointer leading-snug">{label}</span>
  </label>
  {error && <span id={errorId} class="text-xs text-red-500">{error}</span>}
</div>

<style>
  .cb-wrap {
    position: relative;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
    display: block;
  }

  .cb-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .cb-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    border: 1.5px solid currentColor;
    opacity: 0.4;
    transition: background-color 0.15s, border-color 0.15s;
    pointer-events: none;
  }

  .cb-input:checked ~ .cb-box {
    background-color: currentColor;
    border-color: currentColor;
    opacity: 1;
  }

  .cb-icon {
    font-size: 0.875rem !important;
    line-height: 1;
    color: white;
    display: none;
  }

  .cb-input:checked ~ .cb-box .cb-icon {
    display: block;
  }
</style>
