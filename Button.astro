---
import Icon from "./Icon.astro";

interface Props extends astroHTML.JSX.AnchorHTMLAttributes, astroHTML.JSX.ButtonHTMLAttributes {
  href?: string;
  type?: "button" | "submit" | "reset";
  icon?: string;
  circleClass?: string;
  class?: string;
}

const {
  href,
  type = "button",
  icon = "material-symbols:arrow-forward",
  circleClass,
  class: className,
  ...rest
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? "a" : "button";
---

<Tag
  href={isLink ? href : undefined}
  type={!isLink ? type : undefined}
  {...rest}
  class:list={[
    "inline-flex items-center gap-3 pl-6 pr-1 py-1 rounded-full font-medium font-display transition-colors no-underline relative overflow-clip",
    isLink ? "cursor-pointer" : "border-none cursor-pointer",
    className,
  ]}
>
  <span class="flex-1 text-center">
    <slot />
  </span>
  {icon && (
    <span
      class:list={[
        "flex items-center justify-center rounded-full size-10 shrink-0 bg-current/10 text-current",
        circleClass,
      ]}
    >
      <Icon name={icon} class="size-5" />
    </span>
  )}
</Tag>
